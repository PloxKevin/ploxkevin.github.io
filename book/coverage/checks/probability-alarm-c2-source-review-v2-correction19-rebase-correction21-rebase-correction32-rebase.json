  "reviewed_clauses": [
    {
      "source_clause": "Actual prior .02, conditional detection .9 and conditional false alarm .01; Bayes posterior 90/139 and alarm probability .0278.",
      "kind": "mathematical_conclusion",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedAlarmModel.detector_actual_events",
        "SafeLearning.CompleteAppliedAlarmModel.detector_actual_conditionals",
        "SafeLearning.CompleteAppliedAlarmModel.actual_conditioning_formula",
        "SafeLearning.CompleteAppliedAlarmModel.actual_bayes_from_detector_rates"
      ],
      "status": "approved",
      "reason": "The actual four-atom PMF realizes all stated rates; separately, the generic theorem derives the posterior and alarm probability from those three actual probability assumptions on any probability space, with measurable change/alarm events. Posterior is not assumed."
    },
    {
      "source_clause": "Corrected posterior decimal approximately .647; roughly one alarm in three is false despite the conditional 1% false-alarm rate.",
      "kind": "mathematical_conclusion",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedAlarmModel.source_posterior_three_decimal_rounding",
        "SafeLearning.CompleteAppliedAlarmModel.actual_bayes_from_detector_rates"
      ],
      "status": "approved",
      "reason": "The true false-posterior is 49/139, certified within .03 of 1/3. True posterior 90/139 is within .0005 of .647; .648 fails that tolerance. This distinguishes conditioning on alarm from conditioning on no change."
    },
    {
      "source_clause": "Part(b), 500 steps without change yield expected count 5 by linearity, without requiring independence.",
      "kind": "mathematical_conclusion",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedAlarmBatches.actual_false_alarm_expectation",
        "SafeLearning.CompleteAppliedAlarmBatches.actual_500_false_alarm_expectation"
      ],
      "status": "approved",
      "reason": "The actual integral of the sum of measurable indicator variables is n*q on an arbitrary probability space with those per-step marginals, specialized to 500 and .01. The no-change regime is the probability model of these false-alarm events."
    },
    {
      "source_clause": "Part(b), independent steps yield actual any-alarm probability1-.99^500, explicitly approximated.993.",
      "kind": "mathematical_conclusion",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedAlarmBatches.actual_500_independent_alarm_union",
        "SafeLearning.CompleteAppliedAlarmPrecision.source_union_decimal_is_rounded"
      ],
      "status": "approved",
      "reason": "The true independent-event union is the exact power expression. The new actual proof establishes strict rounding error<.0005 and non-equality to the printed decimal; correction17 now explicitly prints approximate equality. No decimal is treated as the exact probability."
    },
    {
      "source_clause": "Corrected part(c) asks for any-alarm probability at most.05; per-step level.05/500=.0001 guarantees this under arbitrary dependence.",
      "kind": "mathematical_conclusion",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedAlarmBatches.source_per_step_false_alarm_level",
        "SafeLearning.CompleteAppliedAlarmBatches.actual_500_arbitrary_dependence_union"
      ],
      "status": "approved",
      "reason": "Actual finite union probability is at most the sum of500 marginals, each at most.0001. The question now agrees with the answer weak inequality; neither independence nor equal rates is required."
    },
    {
      "source_clause": "The corrected weak union endpoint is sharp: an actual dependent probability model has500 alarms each of probability.0001 and any-alarm probability exactly.05. A strict below-.05 guarantee instead follows from a uniform per-step cap strictly below.0001.",
      "kind": "mathematical_precision_and_attaining_model",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedAlarmPrecision.actual_strict_500_union",
        "SafeLearning.CompleteAppliedAlarmPrecision.finiteSharpLaw",
        "SafeLearning.CompleteAppliedAlarmPrecision.finiteSharpAlarm",
        "SafeLearning.CompleteAppliedAlarmPrecision.finite_sharp_alarm_probability",
        "SafeLearning.CompleteAppliedAlarmPrecision.finite_sharp_alarm_disjoint",
        "SafeLearning.CompleteAppliedAlarmPrecision.finite_sharp_union_probability",
        "SafeLearning.CompleteAppliedAlarmPrecision.sharpLaw",
        "SafeLearning.CompleteAppliedAlarmPrecision.sharpAlarm",
        "SafeLearning.CompleteAppliedAlarmPrecision.actual_union_bound_endpoint_attained",
        "SafeLearning.CompleteAppliedAlarmPrecision.endpoint_does_not_guarantee_strict_target"
      ],
      "status": "approved",
      "reason": "The genuine uniform PMF on Fin10000,500 distinct singleton alarms, actual disjointness and true measure of their union establish the attained endpoint. It disproves an unqualified strict guarantee at the chosen level. The generic actual union bound separately proves the strict result when each marginal is bounded by a strictly smaller common cap."
    },
    {
      "source_clause": "Exercise label and Show answer UI.",
      "kind": "navigation_and_pedagogical_labels",
      "lean_declarations": [],
      "status": "not_a_formal_claim",
      "reason": "These exact labels add no mathematical assertion."
    }
