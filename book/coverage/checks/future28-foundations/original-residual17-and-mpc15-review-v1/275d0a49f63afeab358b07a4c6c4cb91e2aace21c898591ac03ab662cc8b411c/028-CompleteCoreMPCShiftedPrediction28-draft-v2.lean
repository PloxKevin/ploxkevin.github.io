import SafeLearning.CompleteCoreMPCFirstSuccessor27

set_option autoImplicit false
noncomputable section
open Set

namespace SafeLearning.CompleteCoreMPCShiftedPrediction28

/-- An actual old feasible prediction, with the original dynamics and every
finite-horizon constraint separately recorded. This is the input to the shift
construction, rather than the conclusion for the new prediction. -/
structure OriginalFeasiblePrediction {S A : Type*}
    (f : S → A → S) (stateStage : ℕ → Set S) (inputStage : ℕ → Set A)
    (terminal : Set S) (N : ℕ) (initial : S) where
  state : ℕ → S
  input : ℕ → A
  initial_eq : state 0 = initial
  dynamics : ∀ j < N, state (j + 1) = f (state j) (input j)
  state_constraints : ∀ j < N, state j ∈ stateStage j
  input_constraints : ∀ j < N, input j ∈ inputStage j
  terminal_constraint : state N ∈ terminal

def nominalExtendedState {S A : Type*}
    {f : S → A → S} {stateStage : ℕ → Set S} {inputStage : ℕ → Set A}
    {terminal : Set S} {N : ℕ} {initial : S}
    (plan : OriginalFeasiblePrediction f stateStage inputStage terminal N initial)
    (terminalControl : S → A) (j : ℕ) : S :=
  if j ≤ N then plan.state j else f (plan.state N) (terminalControl (plan.state N))

def nominalExtendedInput {S A : Type*}
    {f : S → A → S} {stateStage : ℕ → Set S} {inputStage : ℕ → Set A}
    {terminal : Set S} {N : ℕ} {initial : S}
    (plan : OriginalFeasiblePrediction f stateStage inputStage terminal N initial)
    (terminalControl : S → A) (j : ℕ) : A :=
  if j < N then plan.input j else terminalControl (nominalExtendedState plan terminalControl j)

/-- The next prediction is generated by the actual plant and tracking
feedback. No successor state, state-constraint conclusion, or feasible next
plan is supplied as an input. -/
def actualShiftedTrackingState {S A : Type*}
    {f : S → A → S} {stateStage : ℕ → Set S} {inputStage : ℕ → Set A}
    {terminal : Set S} {N : ℕ} {initial : S}
    (plan : OriginalFeasiblePrediction f stateStage inputStage terminal N initial)
    (terminalControl : S → A) (tracking : S → S → A → A)
    (actualNext : S) : ℕ → S
  | 0 => actualNext
  | j + 1 => f (actualShiftedTrackingState plan terminalControl tracking actualNext j)
      (tracking (actualShiftedTrackingState plan terminalControl tracking actualNext j)
        (nominalExtendedState plan terminalControl (j + 1))
        (nominalExtendedInput plan terminalControl (j + 1)))

def actualShiftedTrackingInput {S A : Type*}
    {f : S → A → S} {stateStage : ℕ → Set S} {inputStage : ℕ → Set A}
    {terminal : Set S} {N : ℕ} {initial : S}
    (plan : OriginalFeasiblePrediction f stateStage inputStage terminal N initial)
    (terminalControl : S → A) (tracking : S → S → A → A)
    (actualNext : S) (j : ℕ) : A :=
  tracking (actualShiftedTrackingState plan terminalControl tracking actualNext j)
    (nominalExtendedState plan terminalControl (j + 1))
    (nominalExtendedInput plan terminalControl (j + 1))

theorem actual_shifted_prediction_has_its_true_initial_state_and_plant_recurrence
    {S A : Type*} {f : S → A → S} {stateStage : ℕ → Set S}
    {inputStage : ℕ → Set A} {terminal : Set S} {N : ℕ} {initial : S}
    (plan : OriginalFeasiblePrediction f stateStage inputStage terminal N initial)
    (terminalControl : S → A) (tracking : S → S → A → A) (actualNext : S) :
    actualShiftedTrackingState plan terminalControl tracking actualNext 0 = actualNext ∧
    ∀ j, actualShiftedTrackingState plan terminalControl tracking actualNext (j + 1) =
      f (actualShiftedTrackingState plan terminalControl tracking actualNext j)
        (actualShiftedTrackingInput plan terminalControl tracking actualNext j) := by
  exact ⟨rfl, fun _ => rfl⟩

theorem actual_old_nominal_prediction_extends_with_its_terminal_control_step
    {S A : Type*} {f : S → A → S} {stateStage : ℕ → Set S}
    {inputStage : ℕ → Set A} {terminal : Set S} {N : ℕ} {initial : S}
    (plan : OriginalFeasiblePrediction f stateStage inputStage terminal N initial)
    (terminalControl : S → A) :
    ∀ j ≤ N, nominalExtendedState plan terminalControl (j + 1) =
      f (nominalExtendedState plan terminalControl j)
        (nominalExtendedInput plan terminalControl j) := by
  intro j hj
  by_cases hjN : j < N
  · have hjnext : j + 1 ≤ N := by omega
    simp only [nominalExtendedState, if_pos hj, if_pos hjnext,
      nominalExtendedInput, if_pos hjN]
    exact plan.dynamics j hjN
  · have heq : j = N := by omega
    subst j
    simp [nominalExtendedState, nominalExtendedInput]

/-- If a candidate is written by another representation, the actual plant
recurrence determines its entire state sequence. This conclusion contains no
claim that the candidate satisfies the new constraints. -/
theorem actual_tracking_candidate_state_sequence_is_uniquely_determined_by_the_plant
    {S A : Type*} {f : S → A → S} {stateStage : ℕ → Set S}
    {inputStage : ℕ → Set A} {terminal : Set S} {N : ℕ} {initial : S}
    (plan : OriginalFeasiblePrediction f stateStage inputStage terminal N initial)
    (terminalControl : S → A) (tracking : S → S → A → A) (actualNext : S)
    (candidate : ℕ → S) (hzero : candidate 0 = actualNext)
    (hstep : ∀ j, candidate (j + 1) = f (candidate j)
      (tracking (candidate j) (nominalExtendedState plan terminalControl (j + 1))
        (nominalExtendedInput plan terminalControl (j + 1)))) :
    candidate = actualShiftedTrackingState plan terminalControl tracking actualNext := by
  funext j
  induction j with
  | zero => exact hzero
  | succ j ih =>
      rw [hstep, ih]
      rfl

end SafeLearning.CompleteCoreMPCShiftedPrediction28
