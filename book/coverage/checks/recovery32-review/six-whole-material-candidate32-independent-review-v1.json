          "unchanged_exact_literal": {
            "key": "primer-linalg.html::node-131",
            "source": "SafeLearning/primer-linalg.html",
            "locator": "::node-131",
            "line": 128,
            "tag": "p",
            "classes": [],
            "source_text": "Intuition and example. In the plane $x^\\top y=\\|x\\|\\,\\|y\\|\\cos\\theta$: the inner product measures alignment. For $x=(1,2)$, $y=(3,-1)$: $x^\\top y=1$, $\\|x\\|=\\sqrt5$, $\\|y\\|=\\sqrt{10}$, $\\theta\\approx81.9^\\circ$. With $M=\\mathrm{diag}(1,4)$ (coordinate 2 counts double): $\\langle x,y\\rangle_M=3-8=-5$, $\\|x\\|_M=\\sqrt{17}$, $\\|y\\|_M=\\sqrt{13}$, an obtuse angle. Which vectors are long or perpendicular depends on the inner product.",
            "text_sha256": "b41d4e74cd50854d96ecd9e668259a9969b0f17d37f6b37f82ea77fc044fb78c",
            "source_sha256": "eccae82058c393e24f2eaba52dab9021d988562357a2a9bd43934979e0a1113a",
            "inventory_kind": "source_unit_needs_claim_review"
          },
          "all_subclaim_correspondence": [
            {
              "source_clause": "Every plane pair satisfies the coordinate formulas and cosine alignment identity",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_plane_inner_product_coordinates",
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_plane_norm_coordinates",
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_alignment_identity_for_every_plane_pair"
              ]
            },
            {
              "source_clause": "Printed x=(1,2) and y=(3,-1) have pairing1 and lengths sqrt5 and sqrt10",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_printed_Euclidean_vectors_inner_product_and_lengths"
              ]
            },
            {
              "source_clause": "The actual Euclidean angle is the genuine arccosine and rounds rigorously to81.9 degrees",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_printed_Euclidean_angle_is_the_genuine_arccosine",
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_printed_Euclidean_angle_has_the_rigorous_one_decimal_degree_rounding"
              ]
            },
            {
              "source_clause": "M=diag(1,4) is positive definite and amounts to scaling coordinate2 by two",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_diagonal_weighted_pairing_is_Euclidean_after_the_coordinate_scaling",
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_source_metric_is_positive_definite"
              ]
            },
            {
              "source_clause": "Printed weighted pairing is -5, lengths are sqrt17 and sqrt13, and angle is obtuse",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_weighted_printed_vectors_inner_product_lengths_and_angle",
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_weighted_angle_is_strictly_obtuse"
              ]
            },
            {
              "source_clause": "Actual examples demonstrate that length and perpendicularity depend on the inner product",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsWeightedPlaneAngle32.actual_weighting_changes_perpendicularity_and_length"
              ]
            }
          ],
          "hypotheses": [
            "Plane is EuclideanSpace R (Fin2); the coordinate and alignment identities quantify over every plane pair.",
            "Printed numerical vectors are exactly (1,2) and (3,-1), with sourceMetric=diag(1,4) and the actual second-coordinate scaling.",
            "The angle is independently defined by arccosine; |angleDegrees-81.9|<0.05 is derived, as are positive definiteness and strict obtuseness."
          ],
          "exact_full_peer": {
