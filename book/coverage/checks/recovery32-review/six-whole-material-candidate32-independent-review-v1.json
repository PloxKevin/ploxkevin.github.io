            "bytes": 58043
          }
        },
        {
          "key": "primer-linalg.html::node-202",
          "claim_id": "primer-linalg.html::node-202::surrounding-pending-1",
          "family": "MetricExamplesAndCertifiedBalls10",
          "unchanged_exact_literal": {
            "key": "primer-linalg.html::node-202",
            "source": "SafeLearning/primer-linalg.html",
            "locator": "::node-202",
            "line": 226,
            "tag": "p",
            "classes": [],
            "source_text": "Examples. $\\mathrm{dist}(x,\\{x_1\\le0\\})=\\max\\{x_1,0\\}$; for the unit disc, $\\max\\{\\|x\\|_2-1,0\\}$. The $\\ell_\\infty$ ball $\\{\\|x-x_0\\|_\\infty\\le\\varepsilon\\}$ is the box $|x_i-x_{0,i}|\\le\\varepsilon$, handled coordinate by coordinate by interval methods. Shortest-path length on a grid is a metric too. Certified balls: if $g$ is $L$-Lipschitz with $L\\gt0$ and $g(z)=c\\gt0$, then $g\\ge0$ on $B_{c/L}(z)$, since $g(y)\\ge c-L\\,d(y,z)$; a union of such balls is certified. If $L=0$, the Lipschitz inequality makes $g$ constant on its domain, so the positive value at $z$ certifies the whole domain; no division by zero is needed.",
            "text_sha256": "fa06bbc167ff33b56ed24bd3cd1443b03ef85c5c04dcbd9cabf47ec7ca53424a",
            "source_sha256": "eccae82058c393e24f2eaba52dab9021d988562357a2a9bd43934979e0a1113a",
            "inventory_kind": "source_unit_needs_claim_review"
          },
          "all_subclaim_correspondence": [
            {
              "source_clause": "All-input coordinate halfspace distance is max(x_i,0)",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsMetricExamplesAndCertifiedBalls32.actual_all_input_coordinate_halfspace_distance"
              ]
            },
            {
              "source_clause": "Every real normed unit ball, including the planar unit disc, has distance max(norm(x)-1,0)",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsMetricExamplesAndCertifiedBalls32.actual_every_real_normed_unit_ball_has_the_printed_all_input_distance"
              ]
            },
            {
              "source_clause": "For every real radius an infinity ball is exactly the coordinate box, allowing coordinate-wise intervals",
              "lean_declarations": [
                "SafeLearning.CompleteFoundationsMetricExamplesAndCertifiedBalls32.actual_all_real_radii_infinity_balls_are_coordinate_boxes"
              ]
            },
            {
              "source_clause": "Grid edges are the actual unit steps; rectangular grids are connected and have attained shortest-path metrics",
              "lean_declarations": [
