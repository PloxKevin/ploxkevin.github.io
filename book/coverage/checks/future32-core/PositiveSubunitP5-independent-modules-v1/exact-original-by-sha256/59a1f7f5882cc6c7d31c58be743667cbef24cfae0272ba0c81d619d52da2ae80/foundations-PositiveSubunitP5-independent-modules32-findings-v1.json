    {
      "declaration": "SafeLearning.CompleteFoundationsPositiveSubunitPNorm32.actual_coordinate_unit_has_power_quasinorm_one",
      "complete_body_sha256": "7ebd5b35476180c8890007796020280d9d0ed2dfa8d488c23722995237b54a90",
      "exact_signature": "theorem actual_coordinate_unit_has_power_quasinorm_one\n    (p : ℝ) (hp : 0 < p) (i : I) : powerQuasiNorm p (Pi.single i (1:ℝ))=1"
    },
    {
      "declaration": "SafeLearning.CompleteFoundationsPositiveSubunitPNorm32.actual_two_distinct_units_have_power_quasinorm_two_to_inverse_p",
      "complete_body_sha256": "5785e4aa625bde86afab50447922e925596e2315fbc932de093cd463390948e3",
      "exact_signature": "theorem actual_two_distinct_units_have_power_quasinorm_two_to_inverse_p\n    (p : ℝ) (hp : 0 < p) (i j : I) (hij : i≠j) :\n    powerQuasiNorm p (Pi.single i (1:ℝ)+Pi.single j (1:ℝ))=(2:ℝ)^(1/p)"
    },
    {
      "declaration": "SafeLearning.CompleteFoundationsPositiveSubunitPNorm32.actual_every_positive_subunit_exponent_fails_the_triangle_inequality",
      "complete_body_sha256": "874b75a122dd0b9c0e764c5530f8fe188a3ead7ad3fc7f69121336a494e007fc",
      "exact_signature": "theorem actual_every_positive_subunit_exponent_fails_the_triangle_inequality\n    [Nontrivial I] (p : ℝ) (hp : 0 < p) (hp1 : p < 1) :\n    ∃ x y : I → ℝ,powerQuasiNorm p x+powerQuasiNorm p y < powerQuasiNorm p (x+y)"
    },
    {
      "declaration": "SafeLearning.CompleteFoundationsPositiveSubunitPNorm32.actual_printed_half_exponent_values_are_four_versus_one_plus_one",
      "complete_body_sha256": "8809ac4c4bb78acedebd465318398c512514926bbb435c908281af654b4ae8cb",
      "exact_signature": "theorem actual_printed_half_exponent_values_are_four_versus_one_plus_one :\n    powerQuasiNorm (1/2) (![1,1] : Fin 2 → ℝ)=4 ∧\n    powerQuasiNorm (1/2) (![1,0] : Fin 2 → ℝ)=1 ∧\n    powerQuasiNorm (1/2) (![0,1] : Fin 2 → ℝ)=1 ∧ (2:ℝ) < 4"
    },
    {
      "declaration": "SafeLearning.CompleteFoundationsPositiveSubunitPNorm32.actual_one_dimensional_positive_power_formula_is_still_absolute_value",
      "complete_body_sha256": "22d4c7f20ac665289e31a0dfdb7c6e0c42abba5b051309ae5a3d2b84523ca0ad",
      "exact_signature": "theorem actual_one_dimensional_positive_power_formula_is_still_absolute_value\n    (p : ℝ) (hp : 0 < p) (x : Fin 1 → ℝ) : powerQuasiNorm p x=|x 0|"
    }
  ],
  "entire_current_literal": {
    "key": "primer-linalg.html::node-171",
    "source": "SafeLearning/primer-linalg.html",
    "locator": "::node-171",
    "line": 180,
    "tag": "div",
    "classes": [],
    "source_text": "For $p\\lt1$ the formula is not a norm: $p=\\tfrac12$ gives $\\|(1,1)\\|=4\\gt\\|(1,0)\\|+\\|(0,1)\\|=2$. And modules switch norms: Module 11's Berkenkamp bounds use the 1-norm, while its robust MPC uses Euclidean state norms and the input $\\ell_\\infty$ norm. Always check which norm a constant refers to.",
    "text_sha256": "d7073f61b84c8e6c841d05ad43419854a12a020ff982c392daf1ca5153bef6f3",
    "source_sha256": "eccae82058c393e24f2eaba52dab9021d988562357a2a9bd43934979e0a1113a",
    "inventory_kind": "surrounding_prose_needs_semantic_classification"
  },
  "entire_prospective_literal": {
    "key": "primer-linalg.html::node-171",
    "source": "SafeLearning/primer-linalg.html",
    "locator": "::node-171",
    "line": 180,
    "tag": "div",
    "classes": [],
    "source_text": "In dimensions $n\\ge2$, for $0\\lt p\\lt1$ the formula is not a norm: $p=\\tfrac12$ gives $\\|(1,1)\\|=4\\gt\\|(1,0)\\|+\\|(0,1)\\|=2$. And modules switch norms: Module 11's Berkenkamp bounds use the 1-norm, while its robust MPC uses Euclidean state norms and the input $\\ell_\\infty$ norm. Always check which norm a constant refers to.",
    "text_sha256": "3adf2a44e5f90cb4758494d28e27624cef92148e19cb92bbae41a0ac290134e4",
    "source_sha256": "44e65657582bf419c6310bcd019b0cb00328376c12263bf3c8d9cd5c44f53406",
    "inventory_kind": "surrounding_prose_needs_semantic_classification"
  },
