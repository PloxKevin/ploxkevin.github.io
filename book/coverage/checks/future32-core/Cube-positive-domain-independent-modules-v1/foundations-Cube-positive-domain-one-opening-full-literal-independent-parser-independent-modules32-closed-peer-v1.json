  "entire_current_and_proposed_literal_records": {
    "primer-linalg.html::node-191": {
      "entire_current": {
        "key": "primer-linalg.html::node-191",
        "source": "SafeLearning/primer-linalg.html",
        "locator": "::node-191",
        "line": 215,
        "tag": "p",
        "classes": [],
        "source_text": "Covering numbers. A cube of side $s$ lies in the $\\ell_2$ ball of radius $s\\sqrt d/2$ about its centre. Cutting $[0,1]^d$ into $m^d$ cubes with $m=\\lceil\\sqrt d/(2\\tau)\\rceil$ covers it by $m^d$ balls of radius $\\tau$; their centres form a $\\tau$-net, and the fewest balls that suffice is the covering number $M(\\tau,[0,1]^d)$. For $\\tau=0.1$: $64$ balls in $d=2$, about $1.1\\times10^{12}$ in $d=10$. If an $L$-Lipschitz function has margin $m_0$ at every net point, its margin is at least $m_0-L\\tau$ everywhere (Primer B).",
        "text_sha256": "2b5fe14f041630ba62172154d5e77b668176bd04d3cb99eb8aa2b4bc106349ce",
        "source_sha256": "eccae82058c393e24f2eaba52dab9021d988562357a2a9bd43934979e0a1113a",
        "inventory_kind": "source_unit_needs_claim_review"
      },
      "entire_proposed": {
        "key": "primer-linalg.html::node-191",
        "source": "SafeLearning/primer-linalg.html",
        "locator": "::node-191",
        "line": 215,
        "tag": "p",
        "classes": [],
        "source_text": "Covering numbers. Assume $s\\ge0$, $\\tau>0$ and $d\\ge1$. A cube of side $s$ lies in the $\\ell_2$ ball of radius $s\\sqrt d/2$ about its centre. Cutting $[0,1]^d$ into $m^d$ cubes with $m=\\lceil\\sqrt d/(2\\tau)\\rceil$ covers it by $m^d$ balls of radius $\\tau$; their centres form a $\\tau$-net, and the fewest balls that suffice is the covering number $M(\\tau,[0,1]^d)$. For $\\tau=0.1$: $64$ balls in $d=2$, about $1.1\\times10^{12}$ in $d=10$. If an $L$-Lipschitz function has margin $m_0$ at every net point, its margin is at least $m_0-L\\tau$ everywhere (Primer B).",
        "text_sha256": "a41c4f82212b5d7309dfdc6304df6d52d82aaf0375fa931201203fb634f14433",
        "source_sha256": "c6b3b61f9060ab29865e1e9a000247dcf7dded3f02e4764a64de4f5ae986cb61",
        "inventory_kind": "source_unit_needs_claim_review"
      }
    }
