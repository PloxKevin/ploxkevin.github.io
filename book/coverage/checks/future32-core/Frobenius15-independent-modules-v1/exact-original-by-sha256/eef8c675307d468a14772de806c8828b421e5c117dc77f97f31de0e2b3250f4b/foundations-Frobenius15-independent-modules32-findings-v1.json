  "entire_current_literals": {
    "primer-linalg.html::node-315": {
      "key": "primer-linalg.html::node-315",
      "source": "SafeLearning/primer-linalg.html",
      "locator": "::node-315",
      "line": 324,
      "tag": "div",
      "classes": [
        "definition-box"
      ],
      "source_text": "\n    Definition — Frobenius norm and trace inner product\n    \n      $\\|A\\|_F=\\sqrt{\\sum_{ij}a_{ij}^2}=\\sqrt{\\mathrm{tr}(A^\\top A)}$ (the matrix as one long vector), with inner product $\\langle A,B\\rangle=\\mathrm{tr}(A^\\top B)=\\sum_{ij}a_{ij}b_{ij}$. Not induced ($\\|I_n\\|_F=\\sqrt n$), but $\\|A\\|_2\\le\\|A\\|_F\\le\\sqrt{\\mathrm{rank}A}\\,\\|A\\|_2$; here $\\|A\\|_F=\\sqrt{10}\\approx3.16$.\n    \n  ",
      "text_sha256": "48254e771d8559e184bad3435e2256523311ea8abbda9bd3c6297492bc74c914",
      "source_sha256": "eccae82058c393e24f2eaba52dab9021d988562357a2a9bd43934979e0a1113a",
      "inventory_kind": "source_unit_needs_claim_review"
    },
    "primer-linalg.html::node-317": {
      "key": "primer-linalg.html::node-317",
      "source": "SafeLearning/primer-linalg.html",
      "locator": "::node-317",
      "line": 326,
