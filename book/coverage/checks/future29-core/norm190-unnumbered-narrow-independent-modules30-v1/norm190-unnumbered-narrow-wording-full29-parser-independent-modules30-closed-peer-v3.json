  "full_current_and_proposed_literal_records": {
    "primer-linalg.html::node-190": {
      "entire_current": {
        "key": "primer-linalg.html::node-190",
        "source": "SafeLearning/primer-linalg.html",
        "locator": "::node-190",
        "line": 212,
        "tag": "div",
        "classes": [],
        "source_text": "To certify the $\\ell_\\infty$ ball of radius $\\varepsilon$ you need an $\\ell_2$ certificate of radius $\\sqrt n\\,\\varepsilon$, not $\\varepsilon$. All norms on $\\mathbb R^n$ are equivalent up to such constants; in infinite dimensions they are not (Section 8).",
        "text_sha256": "2525ab00ee9e3c6c9728668e5a32bc42de139c4e7761681c8de5e3edff918cc8",
        "source_sha256": "20040309756bbd8397cb784410c9320d5d6d3c742aec4c47be96fd0ce1803169",
        "inventory_kind": "surrounding_prose_needs_semantic_classification"
      },
      "entire_proposed": {
        "key": "primer-linalg.html::node-190",
        "source": "SafeLearning/primer-linalg.html",
        "locator": "::node-190",
        "line": 212,
        "tag": "div",
        "classes": [],
        "source_text": "For $\\varepsilon\\ge0$, the smallest Euclidean radius whose ball contains the entire $\\ell_\\infty$ ball of radius $\\varepsilon$ is $\\sqrt n\\,\\varepsilon$. If $\\varepsilon\\gt0$ and $n\\ge2$, an $\\ell_2$ certificate of radius $\\varepsilon$ alone does not cover that entire ball. All norms on $\\mathbb R^n$ are equivalent up to positive constants; in infinite dimensions this guarantee can fail (Section 8).",
        "text_sha256": "e5e621a18abdaa9335806c6288e078c060d19e1e33c6a3ab44073ca4da2083ca",
        "source_sha256": "540e8a025f9ac775bcf70f45ed7da6f5e403c9b4da5e770a4659b125724781f7",
        "inventory_kind": "surrounding_prose_needs_semantic_classification"
      }
    }
  },
  "individual_wording_decisions": [
    {
      "scope": "exact Euclidean covering radius and strict dimension branch",
      "approved": true,
      "reason": "For epsilon>=0 the constant corner attains sqrt(n)*epsilon and all box points satisfy the matching bound. Strict loss relative to epsilon requires epsilon>0 and n>=2; dimension one and zero radius are explicitly excluded from that strict claim. This is ball containment, with finite dimension n including zero."
    },
    {
      "scope": "finite norm equivalence and infinite-dimensional possibility",
      "approved": true,
      "reason": "Finite-dimensional norms admit positive two-sided comparison constants. In infinite dimensions this universal guarantee can fail; it does not assert that every pair of norms differs. The Section8 x^k supremum/L2 example is a genuine counterexample to a uniform reverse bound."
    }
  ],
