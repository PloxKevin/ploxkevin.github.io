  "pointer_rules": [
    "Pointers are nonempty arrays of exact dictionary keys or integer list indexes. They select original fields without changing any candidate, offer, peer or native.",
    "offer_inventory_pointer selects a typed immutable ref whose sha256 is current Source79 inventory9f2a.",
    "peer_candidate_pointer and offer_candidate_pointer select the complete exact candidate ref including bytes if the offer has bytes.",
    "peer_approved_mapping_pointers select true independent forward, inverse, preservation and source-domain approval flags as applicable; no mathematical scope is inferred from a true native exit alone.",
    "peer_actual_native_pointer selects the exact native ref that actually performed the final independent mapping reader.",
    "offer_evidence_sha256_pointer selects a nonempty immutable Root-relative file-to-SHA map; use archived old raw29 byte aliases rather than mutable book/coverage/<owner>.json destinations.",
    "offer_new_proof_rows_pointer selects the owner canonical-to-new-proof-metadata dictionary. Expected roles are Core1/58, Foundation27/370, Applied2/34, Module15/504.",
    "mapping_original_TMP_aliases and helper_review_original_TMP_aliases map each absolute /tmp helper and raw-log path from the actual native to its exact immutable Root-relative byte copy. The native JSON retains its original paths/time/exit code."
  ],
  "new_proof_metadata_required": {
    "sha256": "actual canonical/Root original TMP source SHA",
    "theorem_count": "count of Root public theorem or lemma names",
    "public_theorem_names": "exact ordered Root public theorem/lemma names",
    "mapped_named_declarations": "same ordered Root public theorem/lemma names",
    "actual_pair": "two Root standalone/named six-field pair identities, with truthful optional bytes/native times/invocation ref/original location-first warning count retained",
    "evidence_sha256": "Root-relative dictionary containing all six actual native/raw/source-snapshot identities, plus any further real evidence retained"
  },
  "retained_diagnostic_count_definition": "re.findall(r'^.*:\\d+:\\d+: warning:', raw.read_text(), re.M); named Lake replay warnings are retained in full raw logs and are not represented as absent",
  "sequence": [
    "Root independently reviews the full integration helper and binding preparer source; close real code-peer native/helper/log aliases before supplying any successful review reference.",
    "After all four final independent mapping peers and the Applied promotions companion peer fields are real, Root writes an exact supplies descriptor matching $defs.supplies.",
    "Root records genuine execution of the binding preparer with --supplies ROOT_RELATIVE_JSON --supplies-sha256 ACTUAL_SHA --output FRESH_ROOT_RELATIVE_CHECKS_JSON. This creates only the binding.",
    "Root records a genuine default integration-helper execution with --binding ACTUAL_BINDING --binding-sha256 ACTUAL_SHA --preflight-output FRESH_REPORT. It validates all90 records and performs the real isolated 556-exercise/12774-material-unit integrity check, requiring coverage incomplete.",
    "Only after that actual preflight and any required Root review, Root can record the helper --apply with a distinct fresh preflight report. It first preserves five original raw29 owner byte copies, then writes exactly the five reviewed candidate byte streams.",
    "Fresh installed global integrity, aggregate kernel replay, axiom audit, Source30 freeze and GitHub publication remain separate actual Root operations; this helper never claims those future results."
  ],
  "fresh_output_paths": {
    "raw29_archive": "reports/full-coverage/owner29-originals-before-owner30-integration-v2",
    "application_result": "reports/full-coverage/owner30-reviewed-candidate-integration-v2.json"
