  "clause_correspondence": [
    {
      "clause": "For epsilon>=0 the smallest Euclidean radius covering the entire infinity ball is sqrt(n)*epsilon.",
      "proofs": [
        "actual_infinity_ball_has_the_dimension_scaled_euclidean_certificate",
        "actual_dimension_scaled_certificate_transfers_every_property",
        "actual_constant_corner_is_inside_the_original_infinity_ball",
        "actual_euclidean_covering_radius_is_exactly_the_dimension_factor"
      ],
      "reason": "Finite coordinate bounds prove sufficient inclusion; the constant corner belongs to the infinity ball and attains sqrt(card I)*epsilon, proving necessity. Empty dimension and radius zero are included."
    },
    {
      "clause": "Strict radius loss is asserted only for epsilon>0 and n>=2.",
      "proofs": [
        "actual_positive_radius_in_dimension_at_least_two_needs_a_larger_cover",
        "actual_one_dimensional_conversion_has_no_strict_radius_loss"
      ],
      "reason": "The constant corner has Euclidean norm greater than epsilon when card>=2; the distinct dimension-one theorem proves no strict loss there."
    },
    {
      "clause": "Every pair of norms on R^n has positive two-sided comparison constants.",
      "proofs": [
        "actual_arbitrary_finite_dimensional_norms_are_equivalent"
      ],
      "reason": "An arbitrary linear equivalence between real normed copies is upgraded to a continuous linear equivalence by finite dimensionality. The two operator norms, enlarged to at least one, derive positive upper and lower constants; no equivalence conclusion is assumed."
    },
    {
      "clause": "In infinite dimensions this guarantee can fail.",
      "proofs": [
        "actual_coordinate_weights_are_strictly_positive_and_at_most_one",
        "actual_diagonal_weight_is_injective",
        "actual_coordinate_spikes_have_supremum_norm_one",
        "actual_weighted_spike_norm_is_its_shrinking_coordinate_weight",
        "actual_two_sequence_norms_have_no_uniform_reverse_constant",
        "actual_weighted_copy_norm_is_the_second_genuine_norm",
        "actual_infinite_dimensional_normed_copies_are_not_equivalent",
        "actual_sequence_space_is_not_finite_dimensional"
      ],
      "reason": "Positive diagonal weights define an injective map on actual bounded sequences and induce a genuine second norm on a linear copy. Coordinate spikes have first norm one and second norm 1/(k+1), disproving every uniform reverse constant. Finite-dimensional equivalence then excludes finite dimensionality. This supplies a counterexample, not a universal claim that every pair differs."
    }
  ],
  "entire_current_literal": {
    "key": "primer-linalg.html::node-190",
