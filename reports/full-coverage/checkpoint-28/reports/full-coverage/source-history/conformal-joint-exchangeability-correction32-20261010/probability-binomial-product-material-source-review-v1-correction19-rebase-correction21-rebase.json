  "reviewed_clauses": [
    {
      "source_clause": "Bernoulli(p) takes values1/0 with probabilities p/1-p; its mean is p and variance p(1-p).",
      "status": "approved",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedIIDProducts.actual_bernoulli_atom_probabilities",
        "SafeLearning.CompleteAppliedIIDProducts.actual_bernoulli_mean_and_variance",
        "SafeLearning.CompleteAppliedIIDProducts.actual_indicator_has_source_bernoulli_law",
        "SafeLearning.CompleteAppliedBinomialModel.actual_indicator_mean_and_variance"
      ],
      "reason": "The canonical actual real Bernoulli probability measure has the displayed atoms and genuine integral/variance. An arbitrary measurable event indicator is proved to have exactly this law when its actual event probability is p, and its actual moments are also derived directly. Success/safe-run labels do not change the probability model."
    },
    {
      "source_clause": "Each specified pattern with k successes and n-k failures has probability p^k(1-p)^(n-k) by independence.",
      "status": "approved",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedFailureCounts.failurePattern",
        "SafeLearning.CompleteAppliedFailureCounts.actual_pattern_probability",
        "SafeLearning.CompleteAppliedBinomialModel.actual_pattern_card_probability"
      ],
      "reason": "Actual events in an arbitrary probability space, measurability, and iIndepSet independence give complete-pattern products; complementary failures and cardinality of the complement are retained, for all finite n including zero."
    },
    {
      "source_clause": "The binomial coefficient counts which k of n trials succeed and equals n!/(k!(n-k)!), with0!=1.",
      "status": "approved",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedBinomialModel.count_event_is_pattern_union",
        "SafeLearning.CompleteAppliedBinomialModel.patterns_pairwise_disjoint",
        "SafeLearning.CompleteAppliedBinomialModel.actual_binomial_count_mass",
        "SafeLearning.CompleteAppliedBinomialModel.actual_choose_factorial_formula",
        "SafeLearning.CompleteAppliedIIDProducts.zero_factorial_convention"
      ],
      "reason": "The actual all-k count event is the disjoint union over univ.powersetCard k. The mass proof explicitly invokes the general Finset.card_powersetCard identity, so the coefficient is the actual count of success-index subsets, not an assumed combinatorial scalar; the factorial formula explicitly assumes k<=n as in the source."
    },
    {
      "source_clause": "The actual success count has the binomial law and masses choose(n,k)*p^k*(1-p)^(n-k), for k0..n, with mean np and variance np(1-p).",
      "status": "approved",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedFailureCounts.failedTrials",
        "SafeLearning.CompleteAppliedFailureCounts.failureCount",
        "SafeLearning.CompleteAppliedBinomialModel.failure_count_measurable",
        "SafeLearning.CompleteAppliedBinomialModel.actual_binomial_count_mass",
        "SafeLearning.CompleteAppliedBinomialModel.actual_count_has_binomial_law",
        "SafeLearning.CompleteAppliedBinomialModel.real_count_is_sum_of_indicators",
        "SafeLearning.CompleteAppliedBinomialModel.actual_binomial_count_mean_and_variance"
      ],
      "reason": "The true failureCount name can equally count the designated success events. Its actual pushforward HasLaw binomial is derived from independent events. Real-valued indicator sum and genuine integrability/MemLp plus independence yield the actual expected count and variance, without assuming the target distribution or its moments."
    },
    {
      "source_clause": "P^N is the product law of N independent samples from P; P^N{E} is probability over the whole training set.",
      "status": "approved",
      "lean_declarations": [
        "SafeLearning.CompleteAppliedIIDProducts.iidProductLaw",
        "SafeLearning.CompleteAppliedIIDProducts.actual_product_coordinate_laws",
        "SafeLearning.CompleteAppliedIIDProducts.actual_product_coordinates_independent",
        "SafeLearning.CompleteAppliedIIDProducts.actual_iid_training_law",
        "SafeLearning.CompleteAppliedIIDProducts.actual_training_event_probability"
      ],
      "reason": "The actual measure is Measure.pi over Fin N. Genuine coordinate marginal HasLaw and iIndepFun are proved; any truly independent sample family with those marginal laws has the joint product law, and every measurable training event has the same actual probability under that law."
    },
