  "prior_independent_review": {
    "file": "book/coverage/checks/modules-tanh-2-5-source-review-v1.json",
    "sha256": "92493e57ab43d19fb83778e7f62cce7dc1cfcb1b1592d7c2fe1891f8c3f318f0",
    "scope": "Existing global/local-origin/QC/function-refinement facts reviewed separately for whole2.5; unchanged source/compiler bytes revalidated for these surrounding exact clauses."
  },
  "reviewed_clauses": [
    {
      "id": "literal-incremental-and-fixed-point-QC-definitions",
      "source_clause": "For arbitrary finite-dimensional maps and symmetric multiplier sets, the displayed stacked-difference quadratic defines incrementalQC; fixing the second point gives the nonincrementalQC on a local domain.",
      "status": "approved_precise_component",
      "lean_declarations": [
        "SafeLearning.CompleteModulesTanhOffsetQC.actualSymmetricQCSet",
        "SafeLearning.CompleteModulesTanhOffsetQC.actualIncrementalQC",
        "SafeLearning.CompleteModulesTanhOffsetQC.actualFixedPointQCOn",
        "SafeLearning.CompleteModulesTanhOffsetQC.actual_incremental_constraints_specialize_to_every_fixed_point_and_local_domain"
      ],
      "hypotheses": [
        "Arbitrary finite real coordinates and actual activation map; multiplier matrices are indexed by the sum of two coordinate types. The source restriction to symmetric matrices is encoded by actualSymmetricQCSet. A local domain and fixed center are explicit."
      ],
      "per_clause_reason": "Read actual definitions: every constraint in the set and every pair are quantified; Sum.elim is the displayed input/output stack and actual quadratic is the matrix product. The specialization theorem derives the fixed-point/local constraint from the actual incremental definition. This establishes the definitions and specialization, without claiming a general closed-loop stability theorem.",
      "missing_clauses": []
    },
    {
      "id": "actual-local-origin-sector-and-strict-refinement",
      "source_clause": "For positive radius, actual tanh on the symmetric interval has origin sector[tanh(radius)/radius,1], stronger than its global[0,1] sector.",
      "status": "approved_precise_component",
      "lean_declarations": [
        "SafeLearning.CompleteModulesTanhChords.actual_tanh_literal_origin_sector_bounds",
        "SafeLearning.CompleteModulesTanhRefinement.actual_local_origin_tanh_graph_satisfies_the_tighter_secant_qc",
        "SafeLearning.CompleteModulesTanhSharpBounds.actual_origin_ratio_is_strictly_between_the_endpoint_derivative_and_one",
        "SafeLearning.CompleteModulesTanhFTCRefinement.actual_strictly_larger_lower_slope_strictly_shrinks_the_qc_abstraction",
        "SafeLearning.CompleteModulesTanhFunctionWitness.actual_larger_lower_sector_excludes_a_genuine_weaker_sector_function"
      ],
      "hypotheses": [
        "Radius>0, evaluated real input in the actual symmetric closed interval; ordinary quotient evaluated at the nonzero radius. QC covers zero input directly. Comparisons use upper slope1 and lower slopes in[0,1]."
      ],
      "per_clause_reason": "Reread actual positive-radius theorem and actual graphQC/refinement statements. Positive lower bound and strict abstraction witnesses justify the literal possibility of tighter local sectors. No arbitrary enlarged region of attraction or unconditional stability is inferred.",
      "missing_clauses": []
    },
    {
      "id": "actual-endpoint-minimum-offset-sector",
      "source_clause": "For left<center<right the exact printed minimum of the two endpoint tanh chord slopes and upper slope1 bound every offset point in the closed interval, including the center.",
      "status": "approved_precise_component",
