      "missing_clauses": []
    },
    {
      "source_unit_key": "lipschitz-by-design.html::node-1212",
      "source_sha256": "effef608a87167c12669504a51ecfb23bb1c86bd56d354be1bfe28d7c526a06c",
      "unit_text_sha256": "04d401c431de9e67d02b2974259f4adbb25376b1ad8f306827aabae67f028cd8",
