theorem actual_integer_schedule_has_all_true_step_certificates : schedule.IsChain integerStep := by
  decide

theorem actual_source_orbit_is_enclosed_by_every_verified_schedule_row
    (rows : List (ℕ×ℕ)) (h0 : 0<rows.length)
    (hi : rows[0]'h0=(scale,scale)) (hc : rows.IsChain integerStep) :
    ∀n (hn : n<rows.length),
      (rows[n].1:ℝ)/(scale:ℝ)≤ sourceOrbit n ∧
      sourceOrbit n≤(rows[n].2:ℝ)/(scale:ℝ) ∧ rows[n].1≤rows[n].2 ∧ rows[n].2≤ scale := by
  intro n
  induction n with
  | zero =>
    intro hn
    rw [hi]
    norm_num [sourceOrbit,scale]
  | succ n ih =>
    intro hn
    have hp : n<rows.length := Nat.lt_of_succ_lt hn
    obtain ⟨hl,hu,_,hupper⟩ := ih hp
    have hs := List.isChain_iff_getElem.mp hc n hn
    have hb := actual_verified_integer_step_bounds_the_true_real_map rows[n] rows[n+1]
      (sourceOrbit n) hl hu hupper hs
    exact ⟨hb.1,hb.2,hs.1,hs.2.1⟩

theorem actual_tenth_hundredth_thousandth_states_have_the_printed_nearest_rounding :
    |sourceOrbit 10-209/1000|<1/2000 ∧
    |sourceOrbit 100-7/100|<1/20000 ∧
    |sourceOrbit 1000-223/10000|<1/20000 := by
  have h0 : 0<schedule.length := by decide
  have hi : schedule[0]'h0=(scale,scale) := rfl
  have hall := actual_source_orbit_is_enclosed_by_every_verified_schedule_row
    schedule h0 hi actual_integer_schedule_has_all_true_step_certificates
  have h10 := hall 10 (by decide)
  have h100 := hall 100 (by decide)
  have h1000 := hall 1000 (by decide)
  norm_num [schedule,scale] at h10 h100 h1000
  rw [abs_lt,abs_lt,abs_lt]
  constructor
  · constructor <;> linarith [h10.1,h10.2.1]
  constructor
  · constructor <;> linarith [h100.1,h100.2.1]
  · constructor <;> linarith [h1000.1,h1000.2.1]

theorem actual_three_states_differ_strictly_from_the_printed_decimals :
    sourceOrbit 10<209/1000 ∧ sourceOrbit 100>7/100 ∧ sourceOrbit 1000>223/10000 := by
  have h0 : 0<schedule.length := by decide
  have hi : schedule[0]'h0=(scale,scale) := rfl
  have hall := actual_source_orbit_is_enclosed_by_every_verified_schedule_row
    schedule h0 hi actual_integer_schedule_has_all_true_step_certificates
  have h10 := hall 10 (by decide)
  have h100 := hall 100 (by decide)
  have h1000 := hall 1000 (by decide)
  norm_num [schedule,scale] at h10 h100 h1000
  exact ⟨by linarith [h10.2.1],by linarith [h100.1],by linarith [h1000.1]⟩

end SafeLearning.CompleteFoundationsNonlinearNumerics
