set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 10000000
set_option maxRecDepth 10000
noncomputable section
open Set
namespace SafeLearning.CompleteFoundationsNonlinearNumerics
open CompleteFoundationsNonlinearDecreasingModel

def scale : ℕ := 10000000000

theorem actual_source_map_is_monotone_on_the_unit_interval
    (x y : ℝ) (hx : 0≤x) (hxy : x≤y) (hy : y≤1) : sourceMap x≤ sourceMap y := by
  have hxn : x≤1 := hxy.trans hy
  have hyn : 0≤y := hx.trans hxy
  have hprod : x*y≤1 := by nlinarith
  have hd : sourceMap y-sourceMap x=
      (y-x)*(1-x*y)/((1+x^2)*(1+y^2)) := by
    unfold sourceMap
    field_simp
    ring
  have hp : 0≤(y-x)*(1-x*y) := mul_nonneg (sub_nonneg.mpr hxy) (by linarith)
  have he : 0≤ sourceMap y-sourceMap x := by rw [hd];exact div_nonneg hp (by positivity)
  linarith

def integerStep (a b : ℕ×ℕ) : Prop :=
  b.1≤b.2 ∧ b.2≤ scale ∧
  b.1*(scale^2+a.1^2)≤a.1*scale^2 ∧
  a.2*scale^2≤b.2*(scale^2+a.2^2)

instance : DecidableRel integerStep := fun a b => by
  unfold integerStep
  infer_instance

theorem actual_verified_integer_step_bounds_the_true_real_map
    (a b : ℕ×ℕ) (x : ℝ) (hl : (a.1:ℝ)/(scale:ℝ)≤x)
    (hu : x≤(a.2:ℝ)/(scale:ℝ)) (ha : a.2≤ scale) (hs : integerStep a b) :
    (b.1:ℝ)/(scale:ℝ)≤ sourceMap x ∧ sourceMap x≤(b.2:ℝ)/(scale:ℝ) := by
  have hd : 0<(scale:ℝ) := by norm_num [scale]
  have hau : (a.2:ℝ)/(scale:ℝ)≤1 := (div_le_one hd).mpr (by exact_mod_cast ha)
  have hx : 0≤x := le_trans (by positivity) hl
  have hlo := actual_source_map_is_monotone_on_the_unit_interval
    ((a.1:ℝ)/(scale:ℝ)) x (by positivity) hl (hu.trans hau)
  have hup := actual_source_map_is_monotone_on_the_unit_interval
    x ((a.2:ℝ)/(scale:ℝ)) hx hu hau
  have hfrac (v : ℕ) : sourceMap ((v:ℝ)/(scale:ℝ))=
      (v:ℝ)*(scale:ℝ)/((scale:ℝ)^2+(v:ℝ)^2) := by
    unfold sourceMap
    field_simp
    ring
  constructor
  · apply le_trans _ hlo
    rw [hfrac]
    apply (div_le_div_iff₀ hd (by positivity)).mpr
    have hn : (b.1:ℝ)*((scale:ℝ)^2+(a.1:ℝ)^2)≤(a.1:ℝ)*(scale:ℝ)^2 := by
      exact_mod_cast hs.2.2.1
    nlinarith
  · apply hup.trans
    rw [hfrac]
    apply (div_le_div_iff₀ (by positivity) hd).mpr
    have hn : (a.2:ℝ)*(scale:ℝ)^2≤(b.2:ℝ)*((scale:ℝ)^2+(a.2:ℝ)^2) := by
      exact_mod_cast hs.2.2.2
    nlinarith

