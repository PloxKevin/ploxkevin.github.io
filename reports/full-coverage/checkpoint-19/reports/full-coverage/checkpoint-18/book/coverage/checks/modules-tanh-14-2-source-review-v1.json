      "exercise_text_sha256": "4eff40e4da3e34630464c1fa8b57348828c45397934e51e0e05856851b2d5ce0",
      "review_status": "approved_complete_source",
      "per_exercise_reason": "Read the entire corrected28 question and every answer. Actual global derivative/chord/QC, full printed h proof route, true even continuous r0 extension, exact sharp restricted origin/chord extrema and limits, all four three-place source values, true derivative integral mean and legitimate centred-equilibrium versus arbitrary-pair distinction match. Positive radius is now explicit. Primary Theorem1 uses an offset local equilibrium QC and explicit box containment; this exercise supplies its centred0 special case.",
      "components": [
        {
          "id": "nn-in-the-loop.html::exercise-16::global-real-derivative-chords-and-literal-qc",
          "status": "approved_precise_component",
          "source_clause": "(a) Actual tanh derivative1-tanh² in(0,1], every distinct chord in(0,1], origin sector[0,1] and literal2x2 matrix QC.",
          "lean_declarations": [
            "SafeLearning.CompleteModulesTanhChords.actual_tanh_has_the_literal_strictly_positive_bounded_derivative",
            "SafeLearning.CompleteModulesTanhChords.actual_ordered_tanh_chord_has_a_genuine_mean_value_point",
            "SafeLearning.CompleteModulesTanhChords.actual_tanh_chord_quotient_is_positive_and_at_most_one",
            "SafeLearning.CompleteModulesTanhChords.actual_tanh_literal_origin_sector_bounds",
            "SafeLearning.CompleteModulesTanhChords.actualSourceTanhQCMatrix",
            "SafeLearning.CompleteModulesTanhChords.actual_source_incremental_tanh_qc_has_the_literal_matrix_identity",
            "SafeLearning.CompleteModulesTanhChords.actual_source_incremental_tanh_qc_is_nonnegative"
          ],
          "hypotheses": [
            "Arbitrary real inputs; ratio/chord claims require a nonzero origin input or distinct endpoints. At0 the sector QC holds by tanh0=0."
          ],
          "per_clause_reason": "Actual HasDerivAt and genuine mean-value point derive the printed route; the origin is the actual second endpoint0. The matrix quadratic equals2vw-2w² and nonnegativity is proved from the actual graph. No numerically guessed slope is used.",
          "missing_clauses": []
        },
        {
          "id": "nn-in-the-loop.html::exercise-16::printed-h-route-and-even-zero-extension",
          "status": "approved_precise_component",
          "source_clause": "(b) True even continuous r with r0=1, actual h0=0, h derivative2v tanhv(1-tanh²v), actual h>0 and strict decreasing r on positive inputs.",
          "lean_declarations": [
            "SafeLearning.CompleteModulesTanhSharpExtrema.sourceRatio",
            "SafeLearning.CompleteModulesTanhSharpExtrema.actual_source_ratio_has_the_declared_zero_extension_and_nonzero_quotient",
            "SafeLearning.CompleteModulesTanhSharpExtrema.actual_source_ratio_extension_is_continuous_at_zero",
            "SafeLearning.CompleteModulesTanhSharpExtrema.actual_source_ratio_extension_is_even",
            "SafeLearning.CompleteModulesTanhSharpBounds.sourceH",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_source_h_has_the_printed_derivative",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_source_h_is_positive_for_every_positive_input",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_origin_ratio_has_the_printed_negative_derivative",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_tanh_origin_secant_strictly_decreases_on_positive_inputs",
            "SafeLearning.CompleteModulesTanhAsymptotic.actual_tanh_origin_secant_depends_only_on_absolute_input"
          ],
          "hypotheses": [
            "Source radius barv>0; derivative quotient domain v!=0. Actual h0=0 is definitional from sourceH and tanh0=0."
          ],
          "per_clause_reason": "Read complete functions and proofs. Actual ordinary derivative yields the literal h formula; h positivity is proved by strict monotonicity from0. True quotient derivative is -h/v². The updated function at0 has actual continuity from HasDerivAt and is even; no division-by-zero ratio is silently called1.",
          "missing_clauses": []
        },
        {
          "id": "nn-in-the-loop.html::exercise-16::greatest-origin-sector-and-least-upper",
          "status": "approved_precise_component",
          "source_clause": "(b) Exact largest lower sector tanh(radius)/radius, endpoint attainment at plus/minus radius and upper endpoint1 approached from zero; every nonzero interior ratio strictly below1.",
          "lean_declarations": [
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_origin_ratio_lower_bound_is_attained_and_greatest",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_origin_ratio_is_strictly_between_the_endpoint_derivative_and_one",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_origin_ratio_approaches_the_upper_endpoint_one_at_zero",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_tanh_origin_secant_strictly_decreases_on_positive_inputs",
            "SafeLearning.CompleteModulesTanhSharpExtrema.actual_origin_sector_upper_bound_is_least",
            "SafeLearning.CompleteModulesTanhAsymptotic.actual_tanh_origin_secant_depends_only_on_absolute_input"
          ],
          "hypotheses": [
            "Any positive finite radius, domain0<abs(v)<=radius."
          ],
          "per_clause_reason": "Official IsGreatest/IsLeast bounds use the actual restricted nonzero-origin domain. Lower bound uses actual antitone/even quotient; positive endpoint is a true attainer and evenness gives the negative one. Strict below1 follows the actual positive-input strict secant theorem. Actual zero-limit proves sharp upper1 even though no nonzero point attains it.",
          "missing_clauses": []
        },
        {
          "id": "nn-in-the-loop.html::exercise-16::greatest-distinct-chord-lower-and-upper",
          "status": "approved_precise_component",
          "source_clause": "(b) Exact tightest arbitrary-pair slope bounds1-tanh²radius and1, derivative even/decreasing in absolute input, and short chords approach both endpoints.",
          "lean_declarations": [
            "SafeLearning.CompleteModulesTanhChords.actual_tanh_derivative_has_the_literal_local_lower_bound",
            "SafeLearning.CompleteModulesTanhChords.actual_local_tanh_chord_has_the_literal_positive_lower_and_upper_bound",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_tanh_derivative_strictly_decreases_on_positive_inputs",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_chords_near_the_positive_endpoint_approach_the_lower_derivative_bound",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_chords_near_zero_approach_the_upper_derivative_bound",
            "SafeLearning.CompleteModulesTanhSharpExtrema.localChordLowerBounds",
            "SafeLearning.CompleteModulesTanhSharpExtrema.localChordUpperBounds",
            "SafeLearning.CompleteModulesTanhSharpExtrema.actual_local_chord_lower_bound_is_greatest",
            "SafeLearning.CompleteModulesTanhSharpExtrema.actual_local_chord_upper_bound_is_least"
          ],
          "hypotheses": [
            "Both distinct points belong to[-radius,radius], radius>0. Derivative evenness is the literal1-tanh² formula and tanh oddness, also cosh_abs in the actual proofs."
          ],
          "per_clause_reason": "Read actual restricted IsGreatest/IsLeast proofs; the mean-value point lies between actual endpoints and has the literal derivative bound. Genuine one-sided short-chord limits have eventually-inside distinct endpoints, deriving sharpness rather than assuming it. The printed mean-of-derivative statement is also the standard Mathlib intervalIntegral.integral_eq_sub_of_hasDerivAt applied to the globally continuous literal derivative, divided by the nonzero endpoint distance; this is the same actual derivative/integrability route instantiated in FTCRefinement for origin chords.",
          "missing_clauses": []
        },
        {
          "id": "nn-in-the-loop.html::exercise-16::literal-radius-one-two-roundings",
          "status": "approved_precise_component",
          "source_clause": "(c) Three-place source roundings at1 (.762,.420) and2 (.482,.071), and strict sector lower bound above slope lower bound for every positive radius.",
          "lean_declarations": [
            "SafeLearning.CompleteModulesTanhNumerics.actual_source_local_origin_and_derivative_bounds_at_one_rounding",
            "SafeLearning.CompleteModulesTanhLocalNumerics.actual_source_local_origin_and_derivative_bounds_at_two_rounding",
            "SafeLearning.CompleteModulesTanhSharpBounds.actual_origin_ratio_is_strictly_between_the_endpoint_derivative_and_one"
          ],
          "hypotheses": [
            "Rounded printed values each have actual absolute error below.0005; radius1 and2 positive."
          ],
          "per_clause_reason": "Actual certified exponential rational enclosures prove each rounding. The arbitrary-positive-radius strict inequality is derived from actual h positivity, strengthening the printed weak comparison; no transcendental value is equated exactly to its decimal.",
          "missing_clauses": []
        },
        {
          "id": "nn-in-the-loop.html::exercise-16::literal-ftc-integral-average-and-valid-local-sector",
          "status": "approved_precise_component",
          "source_clause": "(c) Actual tanh(radius)/radius is the derivative integral mean and supports the sharper centred equilibrium QC only on the box; arbitrary-pair increments require the lower chord slope.",
          "lean_declarations": [
            "SafeLearning.CompleteModulesTanhFTCRefinement.actual_tanh_is_the_integral_of_its_literal_derivative",
