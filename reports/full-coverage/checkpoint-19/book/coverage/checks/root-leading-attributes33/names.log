SafeLearning.CompleteAppliedGlobalLipschitzPicard.extendPath_of_mem.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [CompleteSpace E] {lower upper : ℝ} (origin : ↑(Set.Icc lower upper))
  (path : C(↑(Set.Icc lower upper), E)) (time : ℝ) (ht : time ∈ Set.Icc lower upper) :
  SafeLearning.CompleteAppliedGlobalLipschitzPicard.extendPath origin path time = path ⟨time, ht⟩
SafeLearning.CompleteAppliedGlobalLipschitzPicard.extendPath_continuous.{u_1} {E : Type u_1} [NormedAddCommGroup E]
  [NormedSpace ℝ E] [CompleteSpace E] {lower upper : ℝ} (origin : ↑(Set.Icc lower upper))
  (path : C(↑(Set.Icc lower upper), E)) :
  Continuous (SafeLearning.CompleteAppliedGlobalLipschitzPicard.extendPath origin path)
SafeLearning.CompleteModulesLandscapeMaximalEndpoint.forwardTimeDomain_coe (T : ℝ) :
  SafeLearning.CompleteModulesLandscapeMaximalEndpoint.forwardTimeDomain ↑T = Set.Ico 0 T
SafeLearning.CompleteModulesLandscapeMaximalEndpoint.forwardTimeDomain_top :
  SafeLearning.CompleteModulesLandscapeMaximalEndpoint.forwardTimeDomain ⊤ = Set.Ici 0
